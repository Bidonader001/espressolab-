{
	auto_https disable_redirects
	local_certs
	default_sni localhost
	servers {
		protocols h1 h2
	}
}

:443 {
	tls internal {
		on_demand
	}
	reverse_proxy api:8000
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	encode gzip
}

:80 {
	@iclock path /iclock*
	handle @iclock {
		reverse_proxy api:8000
	}
	handle {
		redir https://{host}{uri} 308
	}
}
