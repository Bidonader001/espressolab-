# Copy to .env in this directory. Never commit .env.
#
# Local development works with the defaults below. Production (ENVIRONMENT=production)
# refuses to start until every value that is marked REQUIRED has been changed.

ENVIRONMENT=development

DATABASE_URL=sqlite:///./data/espressolab.db
# Production example (docker compose builds this from POSTGRES_PASSWORD):
# DATABASE_URL=postgresql+psycopg://espressolab:PASSWORD@localhost:5432/espressolab
# Keep the SQLite file outside OneDrive or any synced folder. Sync clients lock the file mid-write.

# REQUIRED in production. 32 or more random characters.
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# REQUIRED in production. Encrypts device communication keys at rest.
#   py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# REQUIRED in production. The first administrator, created only when the database has no users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-EspressoLab-2026

# REQUIRED in production for docker compose.
POSTGRES_PASSWORD=

# REQUIRED in production. Comma separated list of the site addresses that serve the web app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 0 in tests, or when another process already runs the scheduled synchronization.
ENABLE_SCHEDULER=1

# REQUIRED to be 0 in production so labeled simulator data cannot sit next to real attendance.
ALLOW_SIMULATOR=1

TOKEN_HOURS=12
